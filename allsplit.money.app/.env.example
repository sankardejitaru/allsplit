# Override API base URL (optional). Defaults to LOCAL_DEV_IP in constants/config.js
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Notification channels (disabled until providers are configured)
EXPO_PUBLIC_ENABLE_SMS=false
EXPO_PUBLIC_ENABLE_WHATSAPP=false
EXPO_PUBLIC_ENABLE_PUSH=false
# Dev only — set true to show OTP hints in the app
EXPO_PUBLIC_OTP_TEST_MODE=true
